# Copy to .env and populate locally. Never put real values in source control.
PLAID_ENV=sandbox
# Use only countries enabled in your Plaid account: US, CA, or US,CA.
PLAID_COUNTRY_CODES=US
PLAID_CLIENT_ID=
PLAID_SECRET=
# Required only for native iOS Link. Use https://YOUR_DOMAIN/plaid/oauth.
PLAID_REDIRECT_URI=
# Use a long random token for this personal, single-user backend.
TENDER_API_TOKEN=
# Base64-encoded 32-byte AES key. Keep it safe; losing it loses stored bank links.
TENDER_ENCRYPTION_KEY=
TENDER_USER_ID=tender-personal
TENDER_DATA_FILE=./data/bank-links-sandbox.enc
# Switch to a separate bank-links-production.enc when enabling Production.
TENDER_HOST=127.0.0.1
PORT=8787
# Used only to serve the Universal Link association file.
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=com.sean.tender

# Cloudflare/free Apple Personal Team uses the external-browser flow.
# For local Node hosting, set browser mode and a public HTTPS completion host.
TENDER_LINK_MODE=native
TENDER_PUBLIC_URL=
