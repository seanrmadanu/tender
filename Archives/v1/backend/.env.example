# Copy to .env and populate locally. Never put real values in source control.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_REDIRECT_URI=https://YOUR_DOMAIN/plaid/oauth
# Use a long random token for this personal, single-user backend.
TENDER_API_TOKEN=
# Base64-encoded 32-byte AES key. Keep it safe; losing it loses stored bank links.
TENDER_ENCRYPTION_KEY=
TENDER_USER_ID=tender-personal
TENDER_DATA_FILE=./data/bank-links.enc
TENDER_HOST=127.0.0.1
PORT=8787
# Used only to serve the Universal Link association file.
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=com.sean.tender
